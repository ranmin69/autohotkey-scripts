# ============================================================
# 操作系统生成的文件
# ============================================================

# macOS
# 通用
.DS_Store
.AppleDouble
.LSOverride
# 缩略图 / 资源分叉
._*
# 可能出现在卷根目录的文件
.DocumentRevisions-V100
.fseventsd
.Spotlight-V100
.TemporaryItems
.Trashes
.VolumeIcon.icns
.com.apple.timemachine.donotpresent
# 远程 AFP 共享上可能生成的目录
.AppleDB
.AppleDesktop
Network Trash Folder
Temporary Items
.apdisk

# Windows
# 缩略图缓存
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
# 崩溃转储文件
*.stackdump
# 文件夹配置文件
[Dd]esktop.ini
# 文件共享上的回收站
$RECYCLE.BIN/
# Windows 安装包文件
*.cab
*.msi
*.msix
*.msm
*.msp
# Windows 快捷方式
*.lnk

# Linux
.directory
.Trash-*

